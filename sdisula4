        // Firebase Auth Initialization & Realtime Listeners
        async function initAuthAndData() {
            if (!isFirebaseAvailable) {
                // Fallback Local Storage Mode
                loadLocalData();
                renderApp();
                return;
            }

            try {
                // Auth check
                const authToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                if (authToken) {
                    await signInWithCustomToken(auth, authToken);
                } else {
                    await signInAnonymously(auth);
                }

                // Setup Firestore Realtime Sync
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'agendaData', 'main');
                
                onSnapshot(docRef, (snapshot) => {
                    if (snapshot.exists()) {
                        const data = snapshot.data();
                        window.SULA_APP.publishedData = data.published || window.SULA_APP.initialData;
                        window.SULA_APP.draftData = data.draft || JSON.parse(JSON.stringify(window.SULA_APP.publishedData));
                    } else {
                        // Seed database first time
                        const init = window.SULA_APP.initialData;
                        window.SULA_APP.publishedData = init;
                        window.SULA_APP.draftData = JSON.parse(JSON.stringify(init));
                        setDoc(docRef, { published: init, draft: init }).catch(console.error);
                    }
                    renderApp();
                }, (error) => {
                    console.error("Firestore error fallback to local state:", error);
                    loadLocalData();
                    renderApp();
                });

            } catch (err) {
                console.warn("Auth/Firestore connection failed. Running in standalone local mode.", err);
                loadLocalData();
                renderApp();
            }
        }

        function loadLocalData() {
            const saved = localStorage.getItem('sula4_agenda_data');
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    window.SULA_APP.publishedData = parsed.published;
                    window.SULA_APP.draftData = parsed.draft;
                } catch(e) {
                    window.SULA_APP.publishedData = window.SULA_APP.initialData;
                    window.SULA_APP.draftData = JSON.parse(JSON.stringify(window.SULA_APP.initialData));
                }
            } else {
                window.SULA_APP.publishedData = window.SULA_APP.initialData;
                window.SULA_APP.draftData = JSON.parse(JSON.stringify(window.SULA_APP.initialData));
            }
        }

        // Execute initialization when document ready
        document.addEventListener('DOMContentLoaded', () => {
            initAuthAndData();
        });
