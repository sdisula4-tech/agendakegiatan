                        <text x="250" y="440" font-family="Inter, sans-serif" font-weight="800" font-size="20" fill="#22c55e" text-anchor="middle">SEMARANG</text>
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-sula-blue">SD ISLAM SULTAN AGUNG 4 SEMARANG</h1>
                    <h2 class="text-lg font-semibold text-slate-700">AGENDA KEGIATAN SEKOLAH</h2>
                    <p class="text-sm text-slate-500">Tahun Ajaran <span class="school-year-text">2026/2027</span></p>
