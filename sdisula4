                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Kunci Akses / Password</label>
                    <input type="password" id="password" required placeholder="Masukkan password"
                           class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-sula-blue">
                </div>
                <div id="login-error" class="hidden text-red-600 bg-red-50 text-xs p-3 rounded-lg border border-red-200">
                    <!-- Error message injected here -->
                </div>
                <button type="submit" class="w-full bg-sula-blue hover:bg-sula-dark text-white font-medium py-2.5 rounded-lg text-sm transition shadow-md">
                    <i class="fa-solid fa-right-to-bracket mr-2"></i> Masuk Dashboard
                </button>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT APPLICATION LOGIC -->
    <script>
        // Core Logic Application
        function getCurrentData() {
            const app = window.SULA_APP;
            if (app.isAdmin && !app.isPreviewMode) {
                return app.draftData || app.initialData;
            }
            return app.publishedData || app.initialData;
        }

        function renderNavActions() {
            const container = document.getElementById('nav-actions');
            const app = window.SULA_APP;

            if (app.isAdmin) {
                container.innerHTML = `
                    <button onclick="addNewPeriodPrompt()" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition flex items-center gap-1 shadow-sm">
                        <i class="fa-solid fa-plus"></i> Periode Baru
                    </button>
                    <button onclick="publishData()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition flex items-center gap-1 shadow-sm">
                        <i class="fa-solid fa-cloud-arrow-up"></i> Publikasikan
                    </button>
                    <button onclick="handleLogout()" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition flex items-center gap-1">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                `;
                document.getElementById('admin-banner').classList.remove('hidden');
            } else {
                container.innerHTML = `
                    <button onclick="openLoginModal()" class="bg-white/10 hover:bg-white/20 text-white border border-white/30 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition flex items-center gap-1">
                        <i class="fa-solid fa-user-gear"></i> Area Admin / Guru
                    </button>
                `;
                document.getElementById('admin-banner').classList.add('hidden');
            }
        }

        function renderPeriodTabs() {
            const data = getCurrentData();
            const container = document.getElementById('period-tabs');
            const app = window.SULA_APP;

            let html = '';
            // Option to show ALL periods
            const isAllActive = app.activeTab === 'ALL';
            html += `
                <button onclick="switchTab('ALL')" 
                    class="px-4 py-2 rounded-lg text-sm font-semibold transition ${isAllActive ? 'bg-sula-blue text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}">
                    Semua Periode
                </button>
            `;

            data.periods.forEach(period => {
                const isActive = app.activeTab === period;
                html += `
                    <button onclick="switchTab('${period}')" 
                        class="px-4 py-2 rounded-lg text-sm font-semibold transition ${isActive ? 'bg-sula-blue text-white shadow-sm' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}">
                        ${period}
                    </button>
                `;
            });

            container.innerHTML = html;
        }

        function switchTab(tab) {
            window.SULA_APP.activeTab = tab;
            renderPeriodTabs();
            renderMainContent();
        }

        function handleSearch(query) {
            window.SULA_APP.searchQuery = query.toLowerCase();
            renderMainContent();
        }

        function handleClassFilter(cls) {
            window.SULA_APP.filterClass = cls;
            renderMainContent();
        }

        function renderMainContent() {
            const data = getCurrentData();
            const app = window.SULA_APP;
            const container = document.getElementById('agenda-render-area');
            
            let periodsToRender = app.activeTab === 'ALL' ? data.periods : [app.activeTab];
            let html = '';

            periodsToRender.forEach(period => {
                let items = data.agendas[period] || [];

                // Filter logic
                if (app.searchQuery) {
                    items = items.filter(item => 
                        item.kegiatan.toLowerCase().includes(app.searchQuery) ||
                        item.keterangan.toLowerCase().includes(app.searchQuery) ||
                        item.tgl.toLowerCase().includes(app.searchQuery)
                    );
                }

                if (app.filterClass !== 'ALL') {
                    items = items.filter(item => {
                        if (!item.kelas) return false;
                        // Match class string e.g. "1-6" or "4-6" or "5"
                        return item.kelas.includes(app.filterClass) || item.kelas === '1-6';
                    });
                }

                html += renderPeriodSection(period, items);
            });

            // Always render Lain-Lain Section at the bottom
            html += renderLainLainSection(data.lainLain);

            container.innerHTML = html;
        }

        function renderPeriodSection(period, items) {
            const data = getCurrentData();
            const app = window.SULA_APP;
            const nbList = data.nb[period] || [];

            let rowsHtml = '';

            if (items.length === 0) {
                rowsHtml = `
                    <tr>
                        <td colspan="6" class="text-center py-6 text-slate-400 italic">Tidak ada agenda kegiatan yang cocok dengan kriteria.</td>
                    </tr>
                `;
            } else {
                items.forEach((item, index) => {
                    if (app.isAdmin && !app.isPreviewMode) {
                        rowsHtml += `
                            <tr class="hover:bg-amber-50/40 transition border-b border-slate-200">
                                <td class="px-3 py-2 text-center text-xs font-mono text-slate-400">
                                    <div class="flex items-center justify-center gap-1">
                                        <button onclick="moveRow('${period}', ${index}, -1)" title="Naik" class="text-slate-400 hover:text-blue-600"><i class="fa-solid fa-chevron-up"></i></button>
                                        <button onclick="moveRow('${period}', ${index}, 1)" title="Turun" class="text-slate-400 hover:text-blue-600"><i class="fa-solid fa-chevron-down"></i></button>
                                    </div>
                                </td>
                                <td class="px-3 py-2 text-sm text-center font-medium">
                                    <input type="text" value="${item.no || ''}" onchange="updateAgendaField('${period}', '${item.id}', 'no', this.value)"
                                           class="w-full text-center bg-white border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-sula-blue">
                                </td>
                                <td class="px-3 py-2 text-sm font-semibold text-slate-800">
                                    <input type="text" value="${item.tgl || ''}" onchange="updateAgendaField('${period}', '${item.id}', 'tgl', this.value)"
                                           class="w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-sula-blue">
                                </td>
                                <td class="px-3 py-2 text-sm">
                                    <textarea onchange="updateAgendaField('${period}', '${item.id}', 'kegiatan', this.value)" rows="1"
                                              class="w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-sula-blue font-medium">${item.kegiatan || ''}</textarea>
                                </td>
                                <td class="px-3 py-2 text-sm text-slate-600">
                                    <textarea onchange="updateAgendaField('${period}', '${item.id}', 'keterangan', this.value)" rows="1"
                                              class="w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-sula-blue">${item.keterangan || ''}</textarea>
                                </td>
                                <td class="px-3 py-2 text-sm text-center">
                                    <input type="text" value="${item.kelas || ''}" onchange="updateAgendaField('${period}', '${item.id}', 'kelas', this.value)"
                                           class="w-full text-center bg-white border border-slate-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-sula-blue font-semibold">
                                </td>
                                <td class="px-3 py-2 text-center">
                                    <button onclick="deleteAgendaRow('${period}', '${item.id}')" class="text-red-500 hover:text-red-700 p-1">
                                        <i class="fa-solid fa-trash-can text-sm"></i>
                                    </button>
                                </td>
                            </tr>
                        `;
                    } else {
                        rowsHtml += `
                            <tr class="hover:bg-slate-50 transition border-b border-slate-200">
                                <td class="px-3 py-3 text-center text-sm font-semibold text-slate-600">${item.no || '-'}</td>
                                <td class="px-3 py-3 text-sm font-bold text-sula-blue whitespace-nowrap">${item.tgl || '-'}</td>
                                <td class="px-4 py-3 text-sm font-medium text-slate-800">${item.kegiatan || '-'}</td>
                                <td class="px-4 py-3 text-sm text-slate-600">${item.keterangan || '-'}</td>
                                <td class="px-3 py-3 text-center text-sm font-semibold text-amber-700 whitespace-nowrap">
                                    ${item.kelas ? `<span class="bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full text-xs">${item.kelas}</span>` : '-'}
                                </td>
                            </tr>
                        `;
                    }
                });
            }

            // NB rendering
            let nbHtml = '';
            nbList.forEach((note, idx) => {
                if (app.isAdmin && !app.isPreviewMode) {
                    nbHtml += `
                        <li class="flex items-center gap-2 mb-2">
                            <i class="fa-solid fa-circle-small text-xs text-amber-500"></i>
                            <input type="text" value="${note}" onchange="updateNBItem('${period}', ${idx}, this.value)"
                                   class="flex-1 bg-white border border-slate-300 rounded px-3 py-1 text-xs focus:ring-1 focus:ring-sula-blue">
                            <button onclick="deleteNBItem('${period}', ${idx})" class="text-red-500 hover:text-red-700">
                                <i class="fa-solid fa-xmark text-sm"></i>
                            </button>
                        </li>
                    `;
                } else {
                    nbHtml += `<li class="text-sm text-slate-700 flex items-start gap-2"><span class="text-sula-gold font-bold">•</span> <span>${note}</span></li>`;
                }
            });

            return `
                <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden transition">
                    <div class="bg-sula-blue text-white px-6 py-4 flex flex-wrap justify-between items-center gap-2">
                        <div>
                            <span class="text-xs font-semibold uppercase tracking-wider text-amber-300">AGENDA BULAN</span>
                            <h2 class="text-xl font-bold">${period}</h2>
                        </div>
                        ${app.isAdmin && !app.isPreviewMode ? `
                            <div class="flex gap-2">
                                <button onclick="addAgendaRow('${period}')" class="bg-amber-500 hover:bg-amber-600 text-white text-xs px-3 py-1.5 rounded font-semibold transition">
                                    <i class="fa-solid fa-plus mr-1"></i> Tambah Kegiatan
                                </button>
                                <button onclick="deletePeriod('${period}')" class="bg-red-600 hover:bg-red-700 text-white text-xs px-3 py-1.5 rounded font-semibold transition">
                                    <i class="fa-solid fa-trash mr-1"></i> Hapus Periode
                                </button>
                            </div>
                        ` : ''}
                    </div>

                    <!-- Table Wrapper -->
                    <div class="table-container overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider border-b border-slate-200">
                                    ${app.isAdmin && !app.isPreviewMode ? '<th class="px-2 py-3 text-center w-10">Urut</th>' : ''}
                                    <th class="px-3 py-3 text-center w-16">NO</th>
                                    <th class="px-3 py-3 w-28">TGL</th>
                                    <th class="px-4 py-3 w-1/3">KEGIATAN</th>
                                    <th class="px-4 py-3">KETERANGAN</th>
                                    <th class="px-3 py-3 text-center w-28">KELAS</th>
                                    ${app.isAdmin && !app.isPreviewMode ? '<th class="px-3 py-3 text-center w-16">Aksi</th>' : ''}
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-200">
                                ${rowsHtml}
                            </tbody>
                        </table>
                    </div>

                    <!-- Catatan / NB Section -->
                    <div class="bg-amber-50/60 p-5 border-t border-amber-200/60">
                        <div class="flex justify-between items-center mb-3">
                            <h4 class="font-bold text-amber-900 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-triangle-exclamation text-amber-600"></i> NB (CATATAN PENTING) ${period}
                            </h4>
                            ${app.isAdmin && !app.isPreviewMode ? `
                                <button onclick="addNBItem('${period}')" class="text-xs bg-amber-200 hover:bg-amber-300 text-amber-900 px-2.5 py-1 rounded font-medium">
                                    <i class="fa-solid fa-plus mr-1"></i> Tambah NB
                                </button>
                            ` : ''}
                        </div>
                        <ul class="space-y-1.5">
                            ${nbHtml || '<li class="text-xs italic text-slate-400">Tidak ada catatan khusus.</li>'}
                        </ul>
                    </div>
                </div>
            `;
        }

        function renderLainLainSection(items) {
            const app = window.SULA_APP;
            let listHtml = '';

            items.forEach((item, idx) => {
                if (app.isAdmin && !app.isPreviewMode) {
                    listHtml += `
                        <div class="flex items-center gap-2 mb-2">
                            <i class="fa-solid fa-check text-emerald-600 text-sm"></i>
                            <input type="text" value="${item}" onchange="updateLainLainItem(${idx}, this.value)"
                                   class="flex-1 bg-white border border-slate-300 rounded px-3 py-1.5 text-xs focus:ring-1 focus:ring-sula-blue">
                            <button onclick="deleteLainLainItem(${idx})" class="text-red-500 hover:text-red-700">
                                <i class="fa-solid fa-trash-can text-sm"></i>
                            </button>
                        </div>
                    `;
                } else {
                    listHtml += `
                        <li class="flex items-start gap-3 bg-white p-3 rounded-lg border border-slate-200 shadow-sm">
                            <div class="bg-emerald-100 text-emerald-700 rounded-full w-5 h-5 flex items-center justify-center shrink-0 text-xs font-bold mt-0.5">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <span class="text-slate-700 text-sm font-medium">${item}</span>
                        </li>
                    `;
                }
            });

            return `
                <div class="bg-slate-100 rounded-xl p-6 border border-slate-300 shadow-sm mt-8">
                    <div class="flex justify-between items-center mb-4">
                        <div class="flex items-center gap-3">
                            <div class="bg-sula-blue text-white p-2 rounded-lg">
                                <i class="fa-solid fa-circle-info"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg">LAIN-LAIN</h3>
                                <p class="text-xs text-slate-500">Informasi dan Ketentuan Tambahan Sekolah</p>
                            </div>
                        </div>
                        ${app.isAdmin && !app.isPreviewMode ? `
                            <button onclick="addLainLainItem()" class="bg-sula-blue hover:bg-sula-dark text-white text-xs px-3 py-1.5 rounded font-semibold transition">
                                <i class="fa-solid fa-plus mr-1"></i> Tambah Poin
                            </button>
                        ` : ''}
                    </div>

                    ${app.isAdmin && !app.isPreviewMode ? `
                        <div class="space-y-1">${listHtml}</div>
                    ` : `
                        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3">${listHtml}</ul>
                    `}
                </div>
            `;
        }

        // EDITING HANDLERS (ADMIN DRAFT MUTATIONS)
        function updateAgendaField(period, id, field, value) {
            const draft = window.SULA_APP.draftData;
            const item = draft.agendas[period].find(i => i.id === id);
            if (item) {
                item[field] = value;
                saveDraftLocally();
            }
        }

        function addAgendaRow(period) {
            const draft = window.SULA_APP.draftData;
            const newId = Date.now().toString();
            const nextNo = (draft.agendas[period].length + 1).toString();

            draft.agendas[period].push({
                id: newId,
                no: nextNo,
                tgl: '',
                kegiatan: 'Kegiatan Baru',
                keterangan: '',
                kelas: '1-6'
            });

            saveDraftLocally();
            renderMainContent();
        }

        function deleteAgendaRow(period, id) {
            const draft = window.SULA_APP.draftData;
            draft.agendas[period] = draft.agendas[period].filter(i => i.id !== id);
            saveDraftLocally();
            renderMainContent();
        }

        function moveRow(period, index, direction) {
            const draft = window.SULA_APP.draftData;
            const list = draft.agendas[period];
            const targetIndex = index + direction;

            if (targetIndex >= 0 && targetIndex < list.length) {
                const temp = list[index];
                list[index] = list[targetIndex];
                list[targetIndex] = temp;
                saveDraftLocally();
                renderMainContent();
            }
        }

        function addNBItem(period) {
            const draft = window.SULA_APP.draftData;
            if (!draft.nb[period]) draft.nb[period] = [];
            draft.nb[period].push("Catatan baru...");
            saveDraftLocally();
            renderMainContent();
        }

        function updateNBItem(period, index, value) {
            const draft = window.SULA_APP.draftData;
            draft.nb[period][index] = value;
            saveDraftLocally();
        }

        function deleteNBItem(period, index) {
            const draft = window.SULA_APP.draftData;
            draft.nb[period].splice(index, 1);
            saveDraftLocally();
            renderMainContent();
        }

        function addLainLainItem() {
            const draft = window.SULA_APP.draftData;
            draft.lainLain.push("Poin informasi baru...");
            saveDraftLocally();
            renderMainContent();
        }

        function updateLainLainItem(index, value) {
            const draft = window.SULA_APP.draftData;
            draft.lainLain[index] = value;
            saveDraftLocally();
        }

        function deleteLainLainItem(index) {
            const draft = window.SULA_APP.draftData;
            draft.lainLain.splice(index, 1);
            saveDraftLocally();
            renderMainContent();
        }

        function addNewPeriodPrompt() {
            const name = prompt("Masukkan Nama Periode / Bulan Baru (Contoh: FEBRUARI):");
            if (name && name.trim()) {
                const cleanName = name.trim().toUpperCase();
                const draft = window.SULA_APP.draftData;
                if (!draft.periods.includes(cleanName)) {
                    draft.periods.push(cleanName);
                    draft.agendas[cleanName] = [];
                    draft.nb[cleanName] = [];
                    window.SULA_APP.activeTab = cleanName;
                    saveDraftLocally();
                    renderPeriodTabs();
                    renderMainContent();
                } else {
                    alert("Periode tersebut sudah ada!");
                }
            }
        }

        function deletePeriod(period) {
            if (confirm(`Apakah Anda yakin ingin menghapus seluruh agenda periode ${period}?`)) {
                const draft = window.SULA_APP.draftData;
                draft.periods = draft.periods.filter(p => p !== period);
                delete draft.agendas[period];
                delete draft.nb[period];
                window.SULA_APP.activeTab = 'ALL';
                saveDraftLocally();
                renderPeriodTabs();
                renderMainContent();
            }
        }

        function saveDraftLocally() {
            if (!window.SULA_APP.isFirebaseAvailable) {
                localStorage.setItem('sula4_agenda_data', JSON.stringify({
                    published: window.SULA_APP.publishedData,
                    draft: window.SULA_APP.draftData
                }));
            }
        }

        // PUBLISH TO DATABASE / PUBLIC VIEW
        async function publishData() {
            const app = window.SULA_APP;
            app.publishedData = JSON.parse(JSON.stringify(app.draftData));

            if (app.isFirebaseAvailable) {
                try {
                    const docRef = doc(app.db, 'artifacts', app.appId, 'public', 'data', 'agendaData', 'main');
                    await setDoc(docRef, {
                        published: app.publishedData,
                        draft: app.draftData
                    });
                    showNotification("Berhasil mempublikasikan data ke Halaman Publik Orang Tua!");
                } catch (e) {
                    console.error("Error publishing to Firestore:", e);
                    showNotification("Gagal mempublikasikan ke Firestore, tersimpan lokal.", true);
                }
            } else {
                saveDraftLocally();
                showNotification("Berhasil dipublikasikan (Mode Lokal)!");
            }
            renderMainContent();
        }

        function toggleAdminPreview() {
            window.SULA_APP.isPreviewMode = !window.SULA_APP.isPreviewMode;
            renderMainContent();
        }

        // LOGIN / LOGOUT AUTHENTICATION LOGIC
        function openLoginModal() {
            document.getElementById('login-modal').classList.remove('hidden');
            document.getElementById('login-error').classList.add('hidden');
        }

        function closeLoginModal() {
            document.getElementById('login-modal').classList.add('hidden');
        }

        function handleLogin(e) {
            e.preventDefault();
            const u = document.getElementById('username').value.trim();
            const p = document.getElementById('password').value.trim();

            // Credentials check
            if (u === 'Guru' && p === 'GuruSula04') {
                window.SULA_APP.isAdmin = true;
                window.SULA_APP.isPreviewMode = false;
                closeLoginModal();
                renderNavActions();
                renderMainContent();
                showNotification("Selamat datang, Admin Guru SD Islam Sultan Agung 4!");
            } else {
                const errDiv = document.getElementById('login-error');
                errDiv.textContent = "Username atau kunci akses salah. Silakan coba kembali.";
                errDiv.classList.remove('hidden');
            }
        }

        function handleLogout() {
            window.SULA_APP.isAdmin = false;
            window.SULA_APP.isPreviewMode = false;
            renderNavActions();
            renderMainContent();
            showNotification("Anda telah keluar dari Dashboard Admin.");
        }

        // PDF GENERATION HANDLER
        function downloadPDF() {
            const element = document.getElementById('agenda-render-area');
            const pdfHeader = document.getElementById('pdf-header');
            
            // Show print header
            pdfHeader.classList.remove('hidden');

            const opt = {
                margin:       [0.5, 0.5, 0.5, 0.5],
                filename:     `Agenda_SD_Islam_Sultan_Agung_4_${window.SULA_APP.activeTab}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            // Generate PDF
            html2pdf().set(opt).from(document.body).save().then(() => {
                pdfHeader.classList.add('hidden');
            });
        }

        function showNotification(msg, isError = false) {
            const toast = document.createElement('div');
            toast.className = `fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl shadow-2xl text-white text-sm font-medium flex items-center gap-2 ${isError ? 'bg-red-600' : 'bg-slate-900'}`;
            toast.innerHTML = `<i class="fa-solid ${isError ? 'fa-circle-exclamation' : 'fa-circle-check text-emerald-400'}"></i> ${msg}`;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 3500);
        }

        // Initial Execution Render
        function renderApp() {
            renderNavActions();
            renderPeriodTabs();
            renderMainContent();
        }
    </script>
</body>
</html>
