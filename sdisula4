    <footer class="bg-slate-800 text-slate-300 py-6 text-center text-xs border-t border-slate-700 no-print mt-12">
        <div class="max-w-7xl mx-auto px-4">
            <p class="font-semibold text-sm mb-1 text-slate-200">SD ISLAM SULTAN AGUNG 4 SEMARANG</p>
            <p class="mb-2">Jl. Kaligawe Raya Km. 4 Semarang | Informasi Agenda & Kegiatan Resmi</p>
            <p class="text-slate-500">&copy; 2026/2027 SD Islam Sultan Agung 4. All rights reserved.</p>
        </div>
    </footer>

    <!-- MODAL LOGIN ADMIN -->
    <div id="login-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-100 max-w-md w-full p-6 sm:p-8 relative">
            <button onclick="closeLoginModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
            <div class="text-center mb-6">
                <div class="w-12 h-12 bg-sula-blue/10 text-sula-blue rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-800">Login Admin / Guru</h3>
                <p class="text-xs text-slate-500 mt-1">Masuk untuk mengelola data agenda sekolah</p>
            </div>

            <form onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Username</label>
                    <input type="text" id="username" required placeholder="Masukkan username"
